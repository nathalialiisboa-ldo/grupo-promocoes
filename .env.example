# Copie este arquivo para um novo arquivo chamado ".env" (sem o ".example"
# no final) e preencha com suas credenciais reais da Shopee Affiliate Open
# API. NUNCA suba o arquivo ".env" para o GitHub - ele já está listado no
# .gitignore, mas confira sempre antes de fazer commit.

SHOPEE_APP_ID=coloque_seu_app_id_aqui
SHOPEE_APP_SECRET=coloque_seu_secret_aqui

# Só mude esta URL se a Shopee te passar um endereço de API diferente do
# padrão abaixo.
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# Quantos segundos esperar entre uma chamada e outra à API (para não
# estourar o limite de taxa da Shopee). Pode aumentar se notar erros de
# "rate limit" nos logs.
SHOPEE_RATE_LIMIT_SECONDS=2

# Quantas ofertas BOAS manter por termo de pesquisa (depois de aplicar o
# filtro de qualidade abaixo). Padrão: 5.
SHOPEE_RESULTS_PER_CATEGORY=5

# Quantos candidatos brutos pedir à API antes de filtrar (precisa ser maior
# que SHOPEE_RESULTS_PER_CATEGORY, já que nem todos vão passar no filtro).
SHOPEE_FETCH_BATCH_SIZE=30

# Nota mínima (de 0 a 5) e vendas mínimas que uma oferta precisa ter para
# ser considerada "boa" e importada. Aumente se ainda estiver vindo
# produto de baixa qualidade; diminua se estiver filtrando ofertas boas
# demais.
SHOPEE_MIN_RATING=4.5
SHOPEE_MIN_SALES=20

# Se "true" (padrão), só importa ofertas de lojas oficiais/preferenciais da
# Shopee (campo shopType) - tende a evitar lojas novas/sem histórico,
# comuns em dropshipping de baixa qualidade.
SHOPEE_REQUIRE_TRUSTED_SHOP=true

# Se "true" (padrão), a busca por palavra-chave só traz ofertas de
# vendedores "key seller" da Shopee (considerados mais confiáveis pela
# própria Shopee) - tende a reduzir anúncios de baixa qualidade/spam de
# palavra-chave. Troque para "false" se isso estiver deixando de fora
# ofertas boas.
SHOPEE_KEY_SELLER_ONLY=true
